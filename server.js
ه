const express = require("express");
const admin = require("firebase-admin");
const crypto = require("crypto");
const path = require("path");

const app = express();

app.use(express.json({ limit: "20kb" }));

const PORT = process.env.PORT || 3000;
const ADMIN_CODE = process.env.ADMIN_CODE;
const SESSION_SECRET = process.env.SESSION_SECRET;

if (!ADMIN_CODE || !SESSION_SECRET || !process.env.FIREBASE_SERVICE_ACCOUNT) {
  throw new Error("Missing required environment variables");
}

const serviceAccount = JSON.parse(process.env.FIREBASE_SERVICE_ACCOUNT);

admin.initializeApp({
  credential: admin.credential.cert(serviceAccount),
  databaseURL: "https://workdz-web-default-rtdb.firebaseio.com"
});

const db = admin.database();

const sessions = new Map();

function clean(value, max) {
  return String(value || "").trim().slice(0, max);
}

function adminOnly(req, res, next) {
  const token = req.headers.authorization?.replace("Bearer ", "");
  const session = sessions.get(token);

  if (!session || session.expires < Date.now()) {
    sessions.delete(token);
    return res.status(401).json({ error: "غير مصرح" });
  }

  next();
}

/* تسجيل دخول المدير */
app.post("/api/admin/login", (req, res) => {
  const code = clean(req.body.code, 100);

  if (code !== ADMIN_CODE) {
    return res.status(401).json({ error: "الرمز غير صحيح" });
  }

  const token = crypto.randomBytes(32).toString("hex");

  sessions.set(token, {
    expires: Date.now() + 8 * 60 * 60 * 1000
  });

  res.json({ success: true, token });
});

/* تسجيل الخروج */
app.post("/api/admin/logout", adminOnly, (req, res) => {
  const token = req.headers.authorization.replace("Bearer ", "");
  sessions.delete(token);
  res.json({ success: true });
});

/* قراءة عدد الإعجابات */
app.get("/api/likes", async (req, res) => {
  try {
    const snap = await db.ref("siteStats/likes").get();
    res.json({ count: Number(snap.val() || 0) });
  } catch {
    res.status(500).json({ error: "تعذر تحميل الإعجابات" });
  }
});

/* تسجيل إعجاب بلا حد */
app.post("/api/likes", async (req, res) => {
  try {
    const name = clean(req.body.name, 50);

    if (!name) {
      return res.status(400).json({ error: "أدخل اسمك" });
    }

    const result = await db.ref("siteStats/likes").transaction(value => {
      return (Number(value) || 0) + 1;
    });

    const visitor = db.ref("likeVisitors").push();

    await visitor.set({
      name,
      createdAt: Date.now()
    });

    res.json({
      success: true,
      count: Number(result.snapshot.val() || 0)
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "تعذر تسجيل الإعجاب" });
  }
});

/* إرسال تعليق للمراجعة */
app.post("/api/comments", async (req, res) => {
  try {
    const name = clean(req.body.name, 50);
    const text = clean(req.body.text, 1000);

    if (!name || !text) {
      return res.status(400).json({ error: "الاسم والتعليق مطلوبان" });
    }

    const item = db.ref("commentInbox").push();

    await item.set({
      name,
      text,
      createdAt: Date.now()
    });

    res.json({
      success: true,
      message: "تم إرسال التعليق للمراجعة"
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "تعذر إرسال التعليق" });
  }
});

/* التعليقات المنشورة فقط */
app.get("/api/comments", async (req, res) => {
  try {
    const snap = await db.ref("publishedComments").get();
    const data = snap.val() || {};

    const comments = Object.entries(data)
      .map(([id, value]) => ({ id, ...value }))
      .sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));

    res.json(comments);
  } catch {
    res.status(500).json({ error: "تعذر تحميل التعليقات" });
  }
});

/* بيانات لوحة الإدارة */
app.get("/api/admin/dashboard", adminOnly, async (req, res) => {
  try {
    const [likes, pending, visitors] = await Promise.all([
      db.ref("siteStats/likes").get(),
      db.ref("commentInbox").get(),
      db.ref("likeVisitors").get()
    ]);

    res.json({
      likes: Number(likes.val() || 0),
      pending: pending.val() || {},
      visitors: visitors.val() || {}
    });
  } catch {
    res.status(500).json({ error: "تعذر تحميل لوحة الإدارة" });
  }
});

/* الموافقة على تعليق */
app.post("/api/admin/approve/:id", adminOnly, async (req, res) => {
  try {
    const id = clean(req.params.id, 150);
    const source = db.ref("commentInbox/" + id);
    const snap = await source.get();

    if (!snap.exists()) {
      return res.status(404).json({ error: "التعليق غير موجود" });
    }

    const comment = snap.val();
    const destination = db.ref("publishedComments").push();

    await destination.set(comment);
    await source.remove();

    res.json({ success: true });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "تعذر نشر التعليق" });
  }
});

/* حذف تعليق معلق */
app.delete("/api/admin/comment/:id", adminOnly, async (req, res) => {
  try {
    await db.ref("commentInbox/" + clean(req.params.id, 150)).remove();
    res.json({ success: true });
  } catch {
    res.status(500).json({ error: "تعذر حذف التعليق" });
  }
});

/* عرض أسماء أصحاب الإعجابات */
app.get("/api/admin/visitors", adminOnly, async (req, res) => {
  try {
    const snap = await db.ref("likeVisitors").get();
    res.json(snap.val() || {});
  } catch {
    res.status(500).json({ error: "تعذر تحميل الأسماء" });
  }
});

/* ملفات الموقع */
app.use(express.static(path.join(__dirname, "public")));

app.listen(PORT, () => {
  console.log("Server running on port " + PORT);
});